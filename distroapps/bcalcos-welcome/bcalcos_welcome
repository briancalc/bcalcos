		text_box.set_valign(Gtk.Align.CENTER)
		name_label = Gtk.Label(label=app_name)
		name_label.set_halign(Gtk.Align.START)
		name_label.set_xalign(0)
		name_label.set_ellipsize(Pango.EllipsizeMode.END)
		name_label.get_style_context().add_class("app-name")
		text_box.pack_start(name_label, False, False, 0)

		status_label = Gtk.Label()
		status_label.set_halign(Gtk.Align.START)
		status_label.set_xalign(0)
		if is_installed is True:
			if app_name in GUIDE_URLS:
				status_label.set_text("✓ Installed · Open Guide")
			else:
				status_label.set_text("✓ Installed · Launch")
			status_label.get_style_context().add_class("app-status-installed")
		elif is_installed is None:
			if app_name in SYSTEM_ACTIONS:
				status_label.set_text("➜ Click to run")
				status_label.get_style_context().add_class("app-status-action")
			else:
				status_label.set_text("➜ Click to open")
				status_label.get_style_context().add_class("app-status-action")
		elif app_name in NOT_REMOVABLE:
			status_label.set_text("Required application unavailable")
			status_label.get_style_context().add_class("app-status")
		else:
			status_label.set_text("Click to Install")
			status_label.get_style_context().add_class("app-status-install")
		text_box.pack_start(status_label, False, False, 0)
		content.pack_start(text_box, True, True, 0)
		button.add(content)
		button.connect("clicked", self._on_app_clicked, app_name, is_installed)
		button.connect("enter-notify-event", self._on_card_pointer_enter, card)
		button.connect("leave-notify-event", self._on_card_pointer_leave, card)
		card.pack_start(button, True, True, 0)

		remove_button = None
		if is_installed is True and app_name not in NOT_REMOVABLE:
			remove_button = Gtk.Button(label="×")
			remove_button.set_relief(Gtk.ReliefStyle.NONE)
			remove_button.set_valign(Gtk.Align.FILL)
			remove_button.set_tooltip_text(f"Remove {app_name}")
			remove_button.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
			remove_button.get_style_context().add_class("app-remove-button")
			remove_button.connect("clicked", self._on_remove_clicked, app_name)
			remove_button.connect("enter-notify-event", self._on_card_pointer_enter, card)
			remove_button.connect("leave-notify-event", self._on_card_pointer_leave, card)
			card.pack_end(remove_button, False, False, 3)

		if is_installed is False and app_name in NOT_REMOVABLE:
			button.set_sensitive(False)

		self.app_buttons[app_name] = {
			"button": button,
			"status": status_label,
			"icon": icon,
			"remove_button": remove_button,
		}
		return card

	def _on_card_pointer_enter(self, _widget, _event, card):
		card.get_style_context().add_class("pointer-hover")
		return False

	def _on_card_pointer_leave(self, _widget, _event, card):
		card.get_style_context().remove_class("pointer-hover")
		return False

	def _on_remove_clicked(self, _remove_button, app_name):
		if app_name in NOT_REMOVABLE:
			return
		info = self.app_buttons.get(app_name)
		if info:
			self._show_remove_confirmation(info["button"], app_name)

	def _on_app_clicked(self, widget, app_name, _initial_status):
		current_status = self.installed_status.get(app_name, _initial_status)

		if app_name in SYSTEM_ACTIONS:
			if app_name == "Run Updates":
				self._run_updates()
			elif app_name == "Keyboard Layout":
				self._show_keyboard_layout_dialog()
			elif app_name == "Settings":
				self._open_settings_manager()
			elif app_name == "Create New User":
				self._show_new_user_dialog()
			elif app_name == "Change Password":
				self._launch_application(widget, app_name)
			return

		if app_name in DOCS_URLS:
			self._open_documentation(DOCS_URLS[app_name])
			return

		if app_name in GUIDE_URLS and current_status is True:
			self._open_documentation(GUIDE_URLS[app_name])
			return

		if current_status is True:
			self._launch_application(widget, app_name)
		elif app_name in NOT_REMOVABLE:
			self._show_error(
				f"{app_name} is a required BcalcOS application, but its executable was not found."
			)
		else:
			self._show_install_confirmation(widget, app_name)

	def _launch_application(self, widget, app_name):
		try:
			if app_name in TERMINAL_LAUNCH_COMMANDS:
				subprocess.Popen(TERMINAL_LAUNCH_COMMANDS[app_name])
				return

			app_info = self._find_desktop_app_info(app_name)
			if app_info is not None and app_info.launch([], None):
				return

			executable = FALLBACK_EXECUTABLES.get(app_name)
			if not executable:
				raise RuntimeError(f"No launch command is configured for {app_name}.")
			subprocess.Popen([executable])
		except Exception as exc:
			self._show_error(f"Could not launch {app_name}.\n\n{exc}")

