	# ========================================================
	# BUTTON HANDLER
	# ========================================================

	def _on_app_clicked(
		self,
		widget,
		app_name,
		is_installed,
	):

		# Use live status rather than the parameter captured
		# at button creation time.
		current_status = self.installed_status.get(
			app_name,
			is_installed,
		)

		if app_name == "TBD":
			return

		# MousePad & Atril are installed-only and not removable.
		if app_name == ("MousePad", "Atril"):
			return

		if app_name == "Run Updates":
			self._run_updates()
			return

		if app_name == "Keyboard Layout":
			self._show_keyboard_layout_dialog()
			return

		if app_name == "Settings":
			self._open_settings_manager()
			return

		if app_name == "ClamAV":
			self._show_install_confirmation(widget, app_name)
			return

		if app_name == "WireGuard":
			self._show_install_confirmation(widget, app_name)
			return

		if app_name == "Create New User":
			self._show_new_user_dialog()
			return

		if app_name in DOCS_URLS:
			self._open_documentation(
				DOCS_URLS[app_name]
			)
			return

		if current_status is True:
			self._show_remove_confirmation(
				widget,
				app_name,
			)
		else:
			self._show_install_confirmation(
				widget,
				app_name,
			)

	# ========================================================
	# INSTALL CONFIRMATION
	# ========================================================

	def _show_install_confirmation(
		self,
		widget,
		app_name,
	):

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.QUESTION,
			buttons=Gtk.ButtonsType.YES_NO,
			text=f"Install {app_name}?",
		)

		dialog.format_secondary_text(
			f"BcalcOS will install {app_name} "
			f"using the system package manager.\n\n"
			f"Administrative authentication may be required."
		)

		response = dialog.run()

		dialog.destroy()

		if response == Gtk.ResponseType.YES:

			self._install_application(
				widget,
				app_name,
			)

	# ========================================================
	# REMOVE CONFIRMATION
	# ========================================================

	def _show_remove_confirmation(
		self,
		widget,
		app_name,
	):

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.WARNING,
			buttons=Gtk.ButtonsType.YES_NO,
			text=f"Remove {app_name}?",
		)

