	def _available_icon_name(self, names):
		icon_theme = Gtk.IconTheme.get_default()
		for icon_name in names:
			try:
				if icon_theme and icon_theme.has_icon(icon_name):
					return icon_name
			except Exception:
				continue
		return "application-x-executable-symbolic"

	def _on_category_selected(self, _button, category_name):
		self._render_category(category_name)

	def _render_category(self, category_name):
		if category_name not in APPS_CONFIG or self.app_container is None:
			return

		self.current_category = category_name
		if self.category_title_label is not None:
				self.category_title_label.set_text(CATEGORY_DISPLAY_NAMES.get(category_name, category_name))

		for name, button in self.category_buttons.items():
			style = button.get_style_context()
			if name == category_name:
				style.add_class("active-category")
			else:
				style.remove_class("active-category")

		for child in self.app_container.get_children():
			self.app_container.remove(child)
		self.app_buttons = {}

		apps = APPS_CONFIG[category_name]
		for row_start in range(0, len(apps), 2):
			row = Gtk.Box(
				orientation=Gtk.Orientation.HORIZONTAL,
				spacing=14,
			)
			row.set_homogeneous(True)
			row.set_halign(Gtk.Align.FILL)
			row.set_hexpand(True)

			# Every row has two equal slots. For an odd final application, the
			# second slot is simply empty; no invisible spacer widget is needed.
			for column in range(2):
				slot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
				slot.set_halign(Gtk.Align.FILL)
				slot.set_hexpand(True)
				app_index = row_start + column
				if app_index < len(apps):
					app_name, configured_status = apps[app_index]
					status = self.installed_status.get(app_name, configured_status)
					card = self._create_app_card(app_name, status)
					card.set_halign(Gtk.Align.FILL)
					card.set_hexpand(True)
					slot.pack_start(card, True, True, 0)
				row.pack_start(slot, True, True, 0)

			self.app_container.pack_start(row, False, True, 0)

		self.app_container.show_all()

	def _find_desktop_app_info(self, app_name):
		if app_name in self.desktop_app_info_cache:
			return self.desktop_app_info_cache[app_name]

		aliases = DESKTOP_NAME_ALIASES.get(app_name, (app_name,))
		wanted_names = {_normalise_app_label(alias) for alias in aliases}
		wanted_executables = {
			_normalise_app_label(os.path.basename(executable))
			for executable in DESKTOP_EXECUTABLE_ALIASES.get(app_name, ())
		}
		name_matches = {}
		executable_match = None

		try:
			for app_info in Gio.AppInfo.get_all():
				try:
					name = app_info.get_name()
					normalised_name = _normalise_app_label(name or "")
					if normalised_name in wanted_names:
						name_matches[normalised_name] = app_info
						continue
					executable = app_info.get_executable()
					if executable and _normalise_app_label(os.path.basename(executable)) in wanted_executables:
						if executable_match is None:
							executable_match = app_info
				except Exception:
					continue
		except Exception:
			name_matches = {}

		result = None
		for alias in aliases:
			result = name_matches.get(_normalise_app_label(alias))
			if result is not None:
				break
		if result is None:
			result = executable_match

		self.desktop_app_info_cache[app_name] = result
		return result

	def _create_app_icon(self, app_name):
		app_info = self._find_desktop_app_info(app_name)
		if app_info is not None:
			try:
				icon_gicon = app_info.get_icon()
				if icon_gicon is not None:
					image = Gtk.Image.new_from_gicon(icon_gicon, Gtk.IconSize.DIALOG)
					image.set_pixel_size(34)
					return image, True
			except Exception:
				pass

		fallback_name = ICON_NAMES.get(app_name, "application-x-executable-symbolic")
		fallback_name = self._available_icon_name((fallback_name, "application-x-executable-symbolic"))
		image = Gtk.Image.new_from_icon_name(fallback_name, Gtk.IconSize.DIALOG)
		image.set_pixel_size(30)
		image.get_style_context().add_class("app-icon-fallback")
		return image, False

	def _create_app_card(self, app_name, is_installed):
		card = Gtk.Box(
			orientation=Gtk.Orientation.HORIZONTAL,
			spacing=0,
		)
