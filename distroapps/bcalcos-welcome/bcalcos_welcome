	@staticmethod
	def _valid_username(username):

		if not username:
			return False

		allowed = (
			"abcdefghijklmnopqrstuvwxyz"
			"0123456789_-"
		)

		return all(
			character in allowed
			for character in username
		)

	# ========================================================
	# USER CREATION - SECURE PRIVILEGED FLOW
	# ========================================================

	def _create_user(
		self,
		username,
		fullname,
		password,
	):

		def worker():

			try:

				# Step 1: Create the user account
				useradd_cmd = ["/usr/sbin/useradd", "-m", "-s", "/bin/bash"]
				if fullname:
					useradd_cmd.extend(["-c", fullname])
				useradd_cmd.append(username)

				result = subprocess.run(
					["pkexec"] + useradd_cmd,
					check=False,
					capture_output=True,
				)

				if result.returncode != 0:
					err_msg = result.stderr.decode("utf-8", errors="replace").strip()
					if not err_msg:
						err_msg = result.stdout.decode("utf-8", errors="replace").strip()
					raise RuntimeError(
						f"The user account could not be created: {err_msg}"
					)

				# Step 2: Set the password
				password_line = (
					f"{username}:{password}\n"
				).encode("utf-8")

				result = subprocess.run(
					["pkexec", "/usr/sbin/chpasswd"],
					input=password_line,
					check=True,
					capture_output=True,
				)

				if result.returncode != 0:
					err_msg = result.stderr.decode("utf-8", errors="replace").strip()
					if not err_msg:
						err_msg = result.stdout.decode("utf-8", errors="replace").strip()
					raise RuntimeError(
						"The user account was created, "
						f"but setting the password failed: {err_msg}"
					)

				GLib.idle_add(
					self._user_creation_finished,
					None,
				)

			except Exception as exc:

				GLib.idle_add(
					self._user_creation_finished,
					str(exc),
				)

		thread = threading.Thread(
			target=worker,
			daemon=True,
		)

		thread.start()

	def _user_creation_finished(
		self,
		error,
	):

		if error:

			self._show_error(
				f"User creation failed.\n\n{error}"
			)

		else:

			self._show_information(
				"The new user account was created successfully."
			)

		return False

