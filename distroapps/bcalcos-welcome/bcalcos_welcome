	# ========================================================
	# PRIVILEGED PACKAGE INSTALL
	# ========================================================

	def _install_application(
		self,
		widget,
		app_name,
	):

		package = PACKAGE_MAP.get(
			app_name
		)

		if not package:
			self._show_error(
				f"No package mapping exists for {app_name}."
			)
			return

		self._set_button_busy(
			widget,
			f"Installing {app_name}..."
		)

		progress_dialog, pulse_id = self._show_package_progress(
			f"Installing {app_name}..."
		)

		thread = threading.Thread(
			target=self._install_worker,
			args=(
				widget,
				app_name,
				package,
				progress_dialog,
				pulse_id,
			),
			daemon=True,
		)

		thread.start()

	def _install_worker(
		self,
		widget,
		app_name,
		package,
		progress_dialog,
		pulse_id,
	):

		try:

			update = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"update",
				],
				check=False,
			)

			if update.returncode != 0:
				raise RuntimeError(
					"Package list update was not completed."
				)

			install = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"install",
					"-y",
					package,
				],
				check=False,
			)

			if install.returncode != 0:
				raise RuntimeError(
					f"Installation of {app_name} was not completed."
				)

			GLib.idle_add(
				self._installation_success,
				widget,
				app_name,
				progress_dialog,
				pulse_id,
			)
		except Exception as exc:

			GLib.idle_add(
				self._installation_failed,
				widget,
				str(exc),
				progress_dialog,
				pulse_id,
			)

	# ========================================================
	# PRIVILEGED PACKAGE REMOVAL
	# ========================================================

	def _remove_application(
		self,
		widget,
		app_name,
	):

		if app_name in NOT_REMOVABLE:
			self._show_error(f"{app_name} cannot be removed from the Welcome Center.")
			return

		package = PACKAGE_MAP.get(
			app_name
		)

		if not package:
			self._show_error(
				f"No package mapping exists for {app_name}."
			)
			return

		self._set_button_busy(
			widget,
			f"Removing {app_name}..."
		)

		progress_dialog, pulse_id = self._show_package_progress(
			f"Removing {app_name}..."
		)

		thread = threading.Thread(
			target=self._remove_worker,
			args=(
				widget,
				app_name,
				package,
				progress_dialog,
				pulse_id,
			),
			daemon=True,
		)

		thread.start()

	def _remove_worker(
		self,
		widget,
		app_name,
		package,
		progress_dialog,
		pulse_id,
	):

		try:

			result = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"remove",
					"-y",
					package,
				],
				check=False,
			)

			if result.returncode != 0:
				raise RuntimeError(
					f"Removal of {app_name} was not completed."
				)

			# Clean up orphaned dependencies.
			# Failure here is non-fatal.
			autoremove = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"autoremove",
					"-y",
				],
				check=False,
			)

			if autoremove.returncode != 0:
				print(
					f"WARNING: autoremove failed after "
					f"removing {app_name}"
				)

			GLib.idle_add(
				self._removal_success,
				widget,
				app_name,
				progress_dialog,
				pulse_id,
			)

		except Exception as exc:

			GLib.idle_add(
				self._removal_failed,
				widget,
				app_name,
				str(exc),
				progress_dialog,
				pulse_id,
			)

	# ========================================================
	# INSTALLATION UI
	# ========================================================

	def _set_button_busy(
		self,
		widget,
		text,
	):

		content = widget.get_child()

		if not content:
			return

		text_box = content.get_children()[-1]

		children = text_box.get_children()

		if len(children) >= 2:

			status = children[1]

			status.set_text(text)

			style = status.get_style_context()
			for class_name in (
				"app-status-install",
				"app-status-installed",
				"app-status-action",
			):
				style.remove_class(class_name)
			style.add_class("app-status-action")

		widget.set_sensitive(False)
		for info in self.app_buttons.values():
			if info.get("button") is widget and info.get("remove_button") is not None:
				info["remove_button"].set_sensitive(False)

	def _installation_success(self, widget, app_name, progress_dialog, pulse_id):
		try:
			GLib.source_remove(pulse_id)
		except Exception:
			pass
		progress_dialog.destroy()
		self.installed_status[app_name] = True
		self.desktop_app_info_cache.pop(app_name, None)
		self._render_category(self.current_category)
		return False

	def _installation_failed(self, widget, message, progress_dialog, pulse_id):
		try:
			GLib.source_remove(pulse_id)
		except Exception:
			pass
		progress_dialog.destroy()
		self._render_category(self.current_category)
		self._show_error(f"Installation failed.\n\n{message}")
		return False

	def _removal_success(self, widget, app_name, progress_dialog, pulse_id):
		try:
			GLib.source_remove(pulse_id)
		except Exception:
			pass
		progress_dialog.destroy()
		self.installed_status[app_name] = False
		self.desktop_app_info_cache.pop(app_name, None)
		self._render_category(self.current_category)
		return False

	def _removal_failed(self, widget, app_name, message, progress_dialog, pulse_id):
		try:
			GLib.source_remove(pulse_id)
		except Exception:
			pass
		progress_dialog.destroy()
		self._render_category(self.current_category)
		self._show_error(f"Removal failed.\n\n{message}")
		return False

