	def _create_category_card(self, category_name):

		frame = Gtk.Box(
			orientation=Gtk.Orientation.VERTICAL,
			spacing=10,
		)

		frame.get_style_context().add_class(
			"category-card"
		)

		# Category header
		header = Gtk.Label(
			label=category_name
		)

		header.set_halign(
			Gtk.Align.FILL
		)

		header.set_xalign(0)

		header.get_style_context().add_class(
			"category-header"
		)

		frame.pack_start(
			header,
			False,
			False,
			0,
		)

		# Small gold accent
		accent = Gtk.Box()

		accent.set_size_request(
			-1,
			4,
		)

		accent.get_style_context().add_class(
			"category-header-accent"
		)

		frame.pack_start(
			accent,
			False,
			False,
			2,
		)

		# Application grid
		grid = Gtk.Grid()

		grid.set_column_homogeneous(True)
		grid.set_column_spacing(10)
		grid.set_row_spacing(10)

		applications = APPS_CONFIG[category_name]

		for index, (app_name, status) in enumerate(applications):
			detected_status = self.installed_status.get(app_name, status)

			button = self._create_app_button(
				app_name,
				detected_status,
			)

			# Two columns in each category.
			column = index % 2
			row = index // 2

			grid.attach(
				button,
				column,
				row,
				1,
				1,
			)

		frame.pack_start(
			grid,
			False,
			False,
			6,
		)

		return frame

