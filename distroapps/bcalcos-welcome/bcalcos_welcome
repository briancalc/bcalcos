	def _get_current_keyboard_layout(self):

		"""Read current XKBLAYOUT from /etc/default/keyboard."""

		try:
			with open(
				"/etc/default/keyboard",
				"r",
			) as f:
				content = f.read()

			for line in content.split("\n"):
				if line.startswith("XKBLAYOUT="):
					value = line.split("=", 1)[1]
					value = value.strip('"\'')
					return value

		except Exception:
			pass

		return None

	def _apply_keyboard_layout(
		self,
		layout_code,
		layout_display_name,
	):

		"""Write new keyboard layout to /etc/default/keyboard via pkexec."""

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.QUESTION,
			buttons=Gtk.ButtonsType.YES_NO,
			text=f"Apply {layout_display_name} keyboard layout?",
		)

		dialog.format_secondary_text(
			"This will update the keyboard layout "
			"for the entire system.\n\n"
			"Changes will take effect at next login."
		)

		response = dialog.run()

		dialog.destroy()

		if response != Gtk.ResponseType.YES:
			return

		thread = threading.Thread(
			target=self._apply_keyboard_worker,
			args=(layout_code, layout_display_name),
			daemon=True,
		)

		thread.start()

	def _apply_keyboard_worker(
		self,
		layout_code,
		layout_display_name,
	):

		try:

			# Read the existing keyboard configuration.
			try:
				with open("/etc/default/keyboard", "r") as f:
					existing_content = f.read()
			except Exception as exc:
				raise RuntimeError(
					f"Could not read /etc/default/keyboard: {exc}"
				)

			# Change only the XKBLAYOUT setting and preserve
			# everything else in the existing file.
			lines = existing_content.splitlines(
				keepends=True
			)

			new_lines = []
			layout_updated = False

			for line in lines:

				if line.lstrip().startswith("XKBLAYOUT="):

					leading = line[
						:len(line) - len(line.lstrip())
					]

					newline = (
						"\n"
						if line.endswith("\n")
						else ""
					)

					new_lines.append(
						f'{leading}XKBLAYOUT="{layout_code}"{newline}'
					)

					layout_updated = True

				else:

					new_lines.append(line)

			# Add XKBLAYOUT if it did not already exist.
			if not layout_updated:

				new_lines.append(
					f'XKBLAYOUT="{layout_code}"\n'
				)

			new_content = "".join(new_lines)

			# Write the preserved configuration via pkexec.
			result = subprocess.run(
				[
					"pkexec",
					"/usr/bin/tee",
					"/etc/default/keyboard",
				],
				input=new_content.encode("utf-8"),
				capture_output=True,
				check=False,
			)

			if result.returncode != 0:
				err_msg = result.stderr.decode("utf-8", errors="replace").strip()
				if not err_msg:
					err_msg = "Permission denied or write failed."
				raise RuntimeError(err_msg)

			GLib.idle_add(
				self._keyboard_layout_finished,
				layout_display_name,
				None,
			)

		except Exception as exc:

			GLib.idle_add(
				self._keyboard_layout_finished,
				layout_display_name,
				str(exc),
			)

	def _keyboard_layout_finished(
		self,
		layout_display_name,
		error,
	):

		if error:

			self._show_error(
				f"Failed to apply keyboard layout.\n\n{error}"
			)

		else:

			self._show_information(
				f"Keyboard layout set to {layout_display_name}. "
				f"Changes will take effect at next login."
			)

		return False


