class SplashScreen(Gtk.Window):

	def __init__(self, parent_app):
		super().__init__(title="BcalcOS")

		self.parent_app = parent_app
		self.elapsed = 0.0
		self.duration = 6.0

		self.set_decorated(False)
		self.set_resizable(False)
		self.set_position(Gtk.WindowPosition.CENTER)
		self.set_default_size(950, 560)

		self.get_style_context().add_class("splash-window")

		self._build_ui()

		self.timer_id = GLib.timeout_add(
			40,
			self._tick,
		)

	def _build_ui(self):

		outer = Gtk.Box(
			orientation=Gtk.Orientation.VERTICAL,
			spacing=0,
		)

		outer.set_margin_start(34)
		outer.set_margin_end(34)
		outer.set_margin_top(30)
		outer.set_margin_bottom(30)

		self.add(outer)

		# ----------------------------------------------------
		# Decorative upper accent
		# ----------------------------------------------------

		accent = Gtk.Box()
		accent.set_size_request(150, 8)
		accent.set_halign(Gtk.Align.CENTER)
		accent.get_style_context().add_class("splash-accent")

		outer.pack_start(
			accent,
			False,
			False,
			0,
		)

		# ----------------------------------------------------
		# Main splash composition
		# ----------------------------------------------------

		content = Gtk.Box(
			orientation=Gtk.Orientation.HORIZONTAL,
			spacing=45,
		)

		content.set_halign(Gtk.Align.CENTER)
		content.set_valign(Gtk.Align.CENTER)
		content.set_vexpand(True)

		outer.pack_start(
			content,
			True,
			True,
			10,
		)

		# ----------------------------------------------------
		# Artwork
		# ----------------------------------------------------

		artwork_box = Gtk.Box(
			orientation=Gtk.Orientation.VERTICAL,
		)

		artwork_box.set_size_request(
			300,
			410,
		)

		artwork_box.set_halign(Gtk.Align.CENTER)
		artwork_box.set_valign(Gtk.Align.CENTER)

		try:
			pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
				ICON_PATH,
				ICON_WIDTH,
				ICON_HEIGHT,
				True,
			)

			# Scale down for the splash while preserving
			# the original 449x641 aspect ratio.
			scale = min(
				290 / pixbuf.get_width(),
				400 / pixbuf.get_height(),
			)

			width = int(pixbuf.get_width() * scale)
			height = int(pixbuf.get_height() * scale)

			pixbuf = pixbuf.scale_simple(
				width,
				height,
				GdkPixbuf.InterpType.BILINEAR,
			)

			image = Gtk.Image.new_from_pixbuf(pixbuf)

		except Exception:
			image = Gtk.Label(label="BcalcOS")
			image.get_style_context().add_class("splash-title")

		artwork_box.pack_start(
			image,
			True,
			True,
			0,
		)

		content.pack_start(
			artwork_box,
			False,
			False,
			0,
		)

		# ----------------------------------------------------
		# Right side text
		# ----------------------------------------------------

		text_box = Gtk.Box(
			orientation=Gtk.Orientation.VERTICAL,
			spacing=7,
		)

		text_box.set_valign(Gtk.Align.CENTER)
		text_box.set_halign(Gtk.Align.START)

		welcome = Gtk.Label(label="Welcome! \n")
		welcome.set_halign(Gtk.Align.START)
		welcome.get_style_context().add_class("splash-welcome")

		title = Gtk.Label(label="BcalcOS")
		title.set_halign(Gtk.Align.START)
		title.get_style_context().add_class("splash-title")

		subtitle = Gtk.Label(
			label="Be systemd free. Be XLibre. Be groovy."
		)
		subtitle.set_halign(Gtk.Align.START)
		subtitle.get_style_context().add_class("splash-subtitle")

		text_box.pack_start(
			welcome,
			False,
			False,
			0,
		)

		text_box.pack_start(
			title,
			False,
			False,
			0,
		)

		text_box.pack_start(
			subtitle,
			False,
			False,
			12,
		)

		content.pack_start(
			text_box,
			False,
			False,
			0,
		)

		# ----------------------------------------------------
		# Bottom message
		# ----------------------------------------------------

		bottom_box = Gtk.Box(
			orientation=Gtk.Orientation.VERTICAL,
			spacing=10,
		)

		bottom_box.set_halign(Gtk.Align.FILL)

		tagline = Gtk.Label(
			label="Based on Devuan Excalibur."
		)

		tagline.set_halign(Gtk.Align.CENTER)
		tagline.get_style_context().add_class("splash-tagline")

		bottom_box.pack_start(
			tagline,
			False,
			False,
			0,
		)

		# Progress bar
		self.progress = Gtk.ProgressBar()
		self.progress.set_fraction(0.0)
		self.progress.set_show_text(False)
		self.progress.get_style_context().add_class("progress-bar")

		bottom_box.pack_start(
			self.progress,
			False,
			False,
			0,
		)

		outer.pack_start(
			bottom_box,
			False,
			False,
			0,
		)

	def _tick(self):

		self.elapsed += 0.05

		fraction = min(
			self.elapsed / self.duration,
			1.0,
		)

		self.progress.set_fraction(fraction)

		if fraction >= 1.0:
			self.hide()

			if self.timer_id:
				GLib.source_remove(self.timer_id)
				self.timer_id = None

			self.parent_app.show_main_window()

			return False

		return True


