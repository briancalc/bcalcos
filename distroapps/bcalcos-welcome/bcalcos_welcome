			False,
			False,
			0,
		)

		text_box.pack_start(
			title,
			False,
			False,
			0,
		)

		text_box.pack_start(
			subtitle,
			False,
			False,
			12,
		)

		content.pack_start(
			text_box,
			False,
			False,
			0,
		)

		# ----------------------------------------------------
		# Bottom message
		# ----------------------------------------------------

		bottom_box = Gtk.Box(
			orientation=Gtk.Orientation.VERTICAL,
