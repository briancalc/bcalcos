			title,
			False,
			False,
			4,
		)

		username = self._create_entry_row(
			box,
			"Username:",
			"lowercase, no spaces",
		)

		fullname = self._create_entry_row(
			box,
			"Full Name:",
			"Optional",
		)

		password = self._create_entry_row(
			box,
			"Password:",
			"Enter password",
		)

		password.set_visibility(False)

		confirm = self._create_entry_row(
			box,
			"Confirm:",
			"Enter password again",
		)

		confirm.set_visibility(False)

		dialog.show_all()

		response = dialog.run()

		if response == Gtk.ResponseType.OK:

			username_text = (
				username.get_text().strip()
			)

			fullname_text = (
				fullname.get_text().strip()
			)

			password_text = (
				password.get_text()
			)

			confirm_text = (
				confirm.get_text()
			)

			if not username_text:
				self._show_error(
					"Username is required."
				)
				return

			elif not password_text:
				self._show_error(
					"Password is required."
				)
				return

			elif password_text != confirm_text:
				self._show_error(
					"Passwords do not match."
				)
				return

			elif not self._valid_username(
				username_text
			):
				self._show_error(
					"Username must contain only "
					"lowercase letters, numbers, "
					"underscores, or hyphens."
				)
				return

			else:

				dialog.destroy()

				self._create_user(
					username_text,
					fullname_text,
					password_text,
				)

				return

