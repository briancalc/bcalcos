	def _get_current_keyboard_layout(self):

		"""Read current XKBLAYOUT from /etc/default/keyboard."""

		try:
			with open(
				"/etc/default/keyboard",
				"r",
			) as f:
				content = f.read()

			for line in content.split("\n"):
				if line.startswith("XKBLAYOUT="):
					value = line.split("=", 1)[1]
					value = value.strip('"\'')
					return value

		except Exception:
			pass

		return None

	def _apply_keyboard_layout(
		self,
		layout_code,
		layout_display_name,
	):

		"""Write new keyboard layout to /etc/default/keyboard via pkexec."""

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.QUESTION,
			buttons=Gtk.ButtonsType.YES_NO,
			text=f"Apply {layout_display_name} keyboard layout?",
		)

		dialog.format_secondary_text(
			"This will update the keyboard layout "
			"for the entire system.\n\n"
			"Changes will take effect at next login."
		)

		response = dialog.run()

		dialog.destroy()

		if response != Gtk.ResponseType.YES:
			return

		thread = threading.Thread(
			target=self._apply_keyboard_worker,
			args=(layout_code, layout_display_name),
			daemon=True,
		)

		thread.start()

	def _apply_keyboard_worker(
		self,
		layout_code,
		layout_display_name,
	):

		try:

			# Read existing file to preserve other settings
			existing_content = ""

			try:
				with open("/etc/default/keyboard", "r") as f:
					existing_content = f.read()
			except Exception:
				pass

			# Parse existing settings
			xkb_model = "pc105"
			xkb_variant = ""
			xkb_options = ""

			for line in existing_content.split("\n"):
				if line.startswith("XKBMODEL="):
					xkb_model = line.split("=", 1)[1].strip('"\'')
				elif line.startswith("XKBVARIANT="):
					xkb_variant = line.split("=", 1)[1].strip('"\'')
				elif line.startswith("XKBOPTIONS="):
					xkb_options = line.split("=", 1)[1].strip('"\'')

			# Build new content
			new_content = f"""\
# Keyboard layout configuration
# Generated by BcalcOS Welcome Center

XKBMODEL="{xkb_model}"
XKBLAYOUT="{layout_code}"
XKBVARIANT="{xkb_variant}"
XKBOPTIONS="{xkb_options}"
BACKSPACE="guess"
"""

			# Write via pkexec
			result = subprocess.run(
				[
					"pkexec",
					"/bin/sh",
					"-c",
					f"cat > /etc/default/keyboard",
				],
				input=new_content.encode("utf-8"),
				capture_output=True,
				check=False,
			)

			if result.returncode != 0:
				err_msg = result.stderr.decode("utf-8", errors="replace").strip()
				if not err_msg:
					err_msg = "Permission denied or write failed."
				raise RuntimeError(err_msg)

			GLib.idle_add(
				self._keyboard_layout_finished,
				layout_display_name,
				None,
			)

		except Exception as exc:

			GLib.idle_add(
				self._keyboard_layout_finished,
				layout_display_name,
				str(exc),
			)

	def _keyboard_layout_finished(
		self,
		layout_display_name,
		error,
	):

		if error:

			self._show_error(
				f"Failed to apply keyboard layout.\n\n{error}"
			)

		else:

			self._show_information(
				f"Keyboard layout set to {layout_display_name}. "
				f"Changes will take effect at next login."
			)

		return False


