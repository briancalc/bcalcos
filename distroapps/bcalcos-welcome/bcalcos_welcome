	# ========================================================
	# BUTTON HANDLER
	# ========================================================

	def _on_app_clicked(
		self,
		widget,
		app_name,
		is_installed,
	):

		# Use live status rather than the parameter captured
		# at button creation time.
		current_status = self.installed_status.get(
			app_name,
			is_installed,
		)

		if app_name == "TBD":
			return

		# MousePad & Atril are installed-only and not removable.
		if app_name in ("MousePad", "Atril"):
			return

		if app_name == "Run Updates":
			self._run_updates()
			return

		if app_name == "Keyboard Layout":
			self._show_keyboard_layout_dialog()
			return

		if app_name == "Settings":
			self._open_settings_manager()
			return

		if app_name == "ClamAV":
			self._show_install_confirmation(widget, app_name)
			return

		if app_name == "WireGuard":
			self._show_install_confirmation(widget, app_name)
			return

		if app_name == "Create New User":
			self._show_new_user_dialog()
			return

		if app_name in DOCS_URLS:
			self._open_documentation(
				DOCS_URLS[app_name]
			)
			return

		if current_status is True:
			self._show_remove_confirmation(
				widget,
				app_name,
			)
		else:
			self._show_install_confirmation(
				widget,
				app_name,
			)

	# ========================================================
	# INSTALL CONFIRMATION
	# ========================================================

	def _show_install_confirmation(
		self,
		widget,
		app_name,
	):

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.QUESTION,
			buttons=Gtk.ButtonsType.YES_NO,
			text=f"Install {app_name}?",
		)

		dialog.format_secondary_text(
			f"BcalcOS will install {app_name} "
			f"using the system package manager.\n\n"
			f"Administrative authentication may be required."
		)

		response = dialog.run()

		dialog.destroy()

		if response == Gtk.ResponseType.YES:

			self._install_application(
				widget,
				app_name,
			)

	# ========================================================
	# REMOVE CONFIRMATION
	# ========================================================

	def _show_remove_confirmation(
		self,
		widget,
		app_name,
	):

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.WARNING,
			buttons=Gtk.ButtonsType.YES_NO,
			text=f"Remove {app_name}?",
		)

		dialog.format_secondary_text(
			f"BcalcOS will uninstall {app_name} "
			f"and clean up unused dependencies.\n\n"
			f"Administrative authentication may be required."
		)

		response = dialog.run()

		dialog.destroy()

		if response == Gtk.ResponseType.YES:

			self._remove_application(
				widget,
				app_name,
			)

	# ========================================================
	# PRIVILEGED PACKAGE INSTALL
	# ========================================================

	def _install_application(
		self,
		widget,
		app_name,
	):

		package = PACKAGE_MAP.get(
			app_name
		)

		if not package:
			self._show_error(
				f"No package mapping exists for {app_name}."
			)
			return

		self._set_button_busy(
			widget,
			f"Installing {app_name}..."
		)

		thread = threading.Thread(
			target=self._install_worker,
			args=(
				widget,
				app_name,
				package,
			),
			daemon=True,
		)

		thread.start()

	def _install_worker(
		self,
		widget,
		app_name,
		package,
	):

		try:

			update = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"update",
				],
				check=False,
			)

			if update.returncode != 0:
				raise RuntimeError(
					"Package list update was not completed."
				)

			install = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"install",
					"-y",
					package,
				],
				check=False,
			)

			if install.returncode != 0:
				raise RuntimeError(
					f"Installation of {app_name} was not completed."
				)

			GLib.idle_add(
				self._installation_success,
				widget,
				app_name,
			)

		except Exception as exc:

			GLib.idle_add(
				self._installation_failed,
				widget,
				str(exc),
			)

	# ========================================================
	# PRIVILEGED PACKAGE REMOVAL
	# ========================================================

	def _remove_application(
		self,
		widget,
		app_name,
	):

		package = PACKAGE_MAP.get(
			app_name
		)

		if not package:
			self._show_error(
				f"No package mapping exists for {app_name}."
			)
			return

		self._set_button_busy(
			widget,
			f"Removing {app_name}..."
		)

		thread = threading.Thread(
			target=self._remove_worker,
			args=(
				widget,
				app_name,
				package,
			),
			daemon=True,
		)

		thread.start()

	def _remove_worker(
		self,
		widget,
		app_name,
		package,
	):

		try:

			result = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"remove",
					"-y",
					package,
				],
				check=False,
			)

			if result.returncode != 0:
				raise RuntimeError(
					f"Removal of {app_name} was not completed."
				)

			# Clean up orphaned dependencies.
			# Failure here is non-fatal.
			autoremove = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"autoremove",
					"-y",
				],
				check=False,
			)

			if autoremove.returncode != 0:
				print(
					f"WARNING: autoremove failed after "
					f"removing {app_name}"
				)

			GLib.idle_add(
				self._removal_success,
				widget,
				app_name,
			)

		except Exception as exc:

			GLib.idle_add(
				self._removal_failed,
				widget,
				app_name,
				str(exc),
			)

	# ========================================================
	# INSTALLATION UI
	# ========================================================

	def _set_button_busy(
		self,
		widget,
		text,
	):

		content = widget.get_child()

		if not content:
			return

		text_box = content.get_children()[-1]

		children = text_box.get_children()

		if len(children) >= 2:

			status = children[1]

			status.set_text(text)

			status.get_style_context().remove_class(
				"status-click"
			)

			status.get_style_context().remove_class(
				"status-installed"
			)

			status.get_style_context().add_class(
				"status-action"
			)

		widget.set_sensitive(False)

	def _installation_success(
		self,
		widget,
		app_name,
	):

		info = self.app_buttons.get(
			app_name
		)

		if info:

			status = info["status"]

			status.get_style_context().remove_class(
				"status-click"
			)

			status.get_style_context().remove_class(
				"status-action"
			)

			status.get_style_context().add_class(
				"status-installed"
			)

			if app_name in ("MousePad", "Atril"):
				status.set_text(
					"✓ Installed"
				)
				info["button"].set_sensitive(
					False
				)
			else:

				status.set_text("✓ Installed  ·  REMOVE?")
				status.get_style_context().add_class(
				    "status-installed-remove"
				)

		self.installed_status[
			app_name
		] = True

		return False

	def _installation_failed(
		self,
		widget,
		message,
	):

		widget.set_sensitive(True)

		self._show_error(
			f"Installation failed.\n\n{message}"
		)

		return False

	# ========================================================
	# REMOVAL UI
	# ========================================================

	def _removal_success(
		self,
		widget,
		app_name,
	):

		info = self.app_buttons.get(
			app_name
		)

		if info:

			status = info["status"]

			status.set_text(
				"Click to Install"
			)

			status.get_style_context().remove_class(
				"status-installed"
			)

			status.get_style_context().remove_class(
				"status-action"
			)

			status.get_style_context().add_class(
				"status-click"
			)

			info["button"].set_sensitive(
				True
			)

		self.installed_status[
			app_name
		] = False

		return False

	def _removal_failed(
		self,
		widget,
		app_name,
		message,
	):

		info = self.app_buttons.get(
			app_name
		)

		if info:

			status = info["status"]

			status.set_text("✓ Installed  ·  REMOVE?")

			status.get_style_context().remove_class(
				"status-action"
			)

			status.get_style_context().add_class(
				"status-installed-remove"
			)

			info["button"].set_sensitive(
				True
			)

		self._show_error(
			f"Removal failed.\n\n{message}"
		)

		return False

	# ========================================================
	# SYSTEM UPDATES
	# ========================================================

	def _run_updates(self):

		dialog = Gtk.MessageDialog(
			transient_for=self,
			modal=True,
			destroy_with_parent=True,
			message_type=Gtk.MessageType.QUESTION,
			buttons=Gtk.ButtonsType.YES_NO,
			text="Run system updates?",
		)

		dialog.format_secondary_text(
			"BcalcOS will update the package lists and "
			"upgrade installed packages.\n\n"
			"Administrative authentication may be required."
		)

		response = dialog.run()

		dialog.destroy()

		if response != Gtk.ResponseType.YES:
			return

		self._show_update_progress()

	def _show_update_progress(self):

		dialog = Gtk.Dialog(
			title="Updating BcalcOS",
			transient_for=self,
			flags=Gtk.DialogFlags.MODAL,
		)

		dialog.set_default_size(
			480,
			180,
		)

		box = dialog.get_content_area()

		box.set_margin_start(25)
		box.set_margin_end(25)
		box.set_margin_top(25)
		box.set_margin_bottom(25)

		label = Gtk.Label(
			label="Updating your system..."
		)

		label.get_style_context().add_class(
			"dialog-title"
		)

		box.pack_start(
			label,
			False,
			False,
			10,
		)

		progress = Gtk.ProgressBar()

		progress.pulse()

		box.pack_start(
			progress,
			False,
			False,
			10,
		)

		dialog.show_all()

		def pulse():

			if not dialog.get_visible():
				return False

			progress.pulse()

			return True

		pulse_id = GLib.timeout_add(
			100,
			pulse,
		)

		thread = threading.Thread(
			target=self._update_worker,
			args=(dialog, pulse_id),
			daemon=True,
		)

		thread.start()

	def _update_worker(
		self,
		dialog,
		pulse_id,
	):

		try:

			result = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"update",
				],
				check=False,
			)

			if result.returncode != 0:
				raise RuntimeError(
					"apt-get update failed."
				)

			result = subprocess.run(
				[
					"pkexec",
					"apt-get",
					"upgrade",
					"-y",
				],
				check=False,
			)

			if result.returncode != 0:
				raise RuntimeError(
					"apt-get upgrade failed."
				)

			GLib.idle_add(
				self._update_finished,
				dialog,
				pulse_id,
				None,
			)

		except Exception as exc:

			GLib.idle_add(
				self._update_finished,
				dialog,
				pulse_id,
				str(exc),
			)

	def _update_finished(
		self,
		dialog,
		pulse_id,
		error,
	):

		try:
			GLib.source_remove(
				pulse_id
			)
		except Exception:
			pass

		dialog.destroy()

		if error:
			self._show_error(
				f"System update failed.\n\n{error}"
			)
		else:
			self._show_information(
				"System update complete."
			)

		return False

