    # ============================================================
    # Combobox
    # ============================================================

    def create_combo(
        self,
        parent,
        variable,
        values,
        callback
    ):
        """Create a Quail-styled combobox."""

        from tkinter import ttk

        style = ttk.Style()

        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        style.configure(
            "Quail.TCombobox",
            font=(
                FONT_PRIMARY,
                11
            ),
            foreground=COLOR_TEXT,
            fieldbackground=COLOR_SURFACE,
            background=COLOR_SURFACE,
            bordercolor=COLOR_BORDER,
            lightcolor=COLOR_BORDER,
            darkcolor=COLOR_BORDER,
            arrowsize=22,
            padding=(8, 7)
        )

        style.map(
            "Quail.TCombobox",
            fieldbackground=[
                ("readonly", COLOR_SURFACE)
            ],
            background=[
                ("active", COLOR_SURFACE)
            ],
            bordercolor=[
                ("focus", COLOR_PRIMARY)
            ]
        )

        combo = ttk.Combobox(
            parent,
            textvariable=variable,
            values=values,
            state="readonly",
            style="Quail.TCombobox"
        )

        combo.bind(
            "<<ComboboxSelected>>",
            callback
        )

        return combo

    # ============================================================
    # Category changed
    # ============================================================

    def category_changed(self, event=None):

        self.update_units()

        self.convert()

    # ============================================================
    # Update units
    # ============================================================

    def update_units(self):

        category = self.category_var.get()

        units = list(
            UNITS[category].keys()
        )

        self.from_combo["values"] = units
        self.to_combo["values"] = units

        if units:

            self.from_var.set(
                units[0]
            )

            if len(units) > 1:
                self.to_var.set(
                    units[1]
                )
            else:
                self.to_var.set(
                    units[0]
                )

    # ============================================================
    # Value changed
    # ============================================================

    def value_changed(self, event=None):

        self.convert()

    # ============================================================
    # Convert
    # ============================================================

    def convert(self, event=None):

        text = self.value_var.get().strip()

        if not text:
            self.result_var.set("")
            return

        try:
            value = Decimal(text)

        except InvalidOperation:
            self.result_var.set(
                "Invalid value"
            )
            return

        category = self.category_var.get()
        from_unit = self.from_var.get()
        to_unit = self.to_var.get()

        if not from_unit or not to_unit:
            return

        try:
            result = convert_value(
                value,
                category,
                from_unit,
                to_unit
            )

        except (ArithmeticError, KeyError):
            self.result_var.set(
                "Unable to convert"
            )
            return

        self.result_var.set(
            format_result(result)
        )

    # ============================================================
    # Swap units
    # ============================================================

    def swap_units(self):

        from_unit = self.from_var.get()
        to_unit = self.to_var.get()

        self.from_var.set(
            to_unit
        )

        self.to_var.set(
            from_unit
        )

        self.convert()

    # ============================================================
    # Clear
    # ============================================================

    def clear(self):

        self.value_var.set("")
        self.result_var.set("")

        self.value_entry.focus_set()


# ============================================================
# Main
# ============================================================

def main():

    root = tk.Tk()

    QuailConverter(root)

    root.mainloop()


if __name__ == "__main__":
    main()