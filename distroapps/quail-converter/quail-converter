# ============================================================
# Unit definitions
# Factors convert each unit to the category's base unit.
# ============================================================

UNITS = {
    "Length": {
        "Millimeters": Decimal("0.001"),
        "Centimeters": Decimal("0.01"),
        "Meters": Decimal("1"),
        "Kilometers": Decimal("1000"),
        "Inches": Decimal("0.0254"),
        "Feet": Decimal("0.3048"),
        "Yards": Decimal("0.9144"),
        "Miles": Decimal("1609.344"),
    },

    "Weight": {
        "Grams": Decimal("1"),
        "Kilograms": Decimal("1000"),
        "Ounces": Decimal("28.349523125"),
        "Pounds": Decimal("453.59237"),
    },

    "Temperature": {
        "Fahrenheit": None,
        "Celsius": None,
        "Kelvin": None,
    },

    "Volume": {
        "Milliliters": Decimal("1"),
        "Liters": Decimal("1000"),
        "Teaspoons": Decimal("4.92892159375"),
        "Tablespoons": Decimal("14.78676478125"),
        "Cups": Decimal("236.5882365"),
        "Pints": Decimal("473.176473"),
        "Quarts": Decimal("946.352946"),
        "Gallons": Decimal("3785.411784"),
    },

    "Time": {
        "Seconds": Decimal("1"),
        "Minutes": Decimal("60"),
        "Hours": Decimal("3600"),
        "Days": Decimal("86400"),
    },
}


# ============================================================
# Temperature conversion
# ============================================================

def convert_temperature(value, from_unit, to_unit):
    """Convert temperature through Celsius."""

    if from_unit == "Fahrenheit":
        celsius = (value - Decimal("32")) * Decimal("5") / Decimal("9")

    elif from_unit == "Celsius":
        celsius = value

    elif from_unit == "Kelvin":
        celsius = value - Decimal("273.15")

    else:
        return None

    if to_unit == "Celsius":
        return celsius

    if to_unit == "Fahrenheit":
        return (celsius * Decimal("9") / Decimal("5")) + Decimal("32")

    if to_unit == "Kelvin":
        return celsius + Decimal("273.15")

    return None


# ============================================================
# General conversion
# ============================================================

def convert_value(value, category, from_unit, to_unit):
    """Convert a value between units."""

    if from_unit == to_unit:
        return value

    if category == "Temperature":
        return convert_temperature(
            value,
            from_unit,
            to_unit
        )

    units = UNITS[category]

    base_value = value * units[from_unit]
    result = base_value / units[to_unit]

    return result


# ============================================================
# Result formatting
# ============================================================

def format_result(value):
    """Format result to a maximum of six decimal places."""

    if value == 0:
        return "0"

    rounded = value.quantize(
        Decimal("0.000001")
    )

    text = format(
        rounded,
        "f"
    )

    if "." in text:
        text = text.rstrip("0").rstrip(".")

    return text


