COLOR_PRIMARY_LIGHT = "#D99A28"
COLOR_PRIMARY_LIGHT_LIGHT = "#EBC978"
COLOR_BG = "#F5F6F8"
COLOR_SURFACE = "#FFFFFF"
COLOR_SURFACE_ALT = "#FBF9F5"
COLOR_TEXT = "#2C3E50"
COLOR_TEXT_MUTED = "#68717A"
COLOR_BORDER = "#E2E5E8"
COLOR_BORDER_GOLD = "#E5C88F"
COLOR_WHITE = "#FFFFFF"
FONT_PRIMARY = "Inter"
FONT_HEADING = "Poppins"
FONT_MONO = "monospace"

VERSION = "1.0.7"
CIPHER_DIR = os.path.expanduser("~/encrypted")
PLAIN_DIR = os.path.expanduser("~/private")


class QuailCrypt:
    def __init__(self, root):
        self.root = root
        self.root.title("Quail Crypt")
        self.root.geometry("700x650")
        self.root.minsize(620, 610)
        self.root.configure(bg=COLOR_BG)

        self.font_title = tkfont.Font(family=FONT_HEADING, size=17, weight="bold")
        self.font_label = tkfont.Font(family=FONT_PRIMARY, size=10)
        self.font_button = tkfont.Font(family=FONT_PRIMARY, size=10)
        self.font_path = tkfont.Font(family=FONT_MONO, size=9)

        self.gocryptfs = shutil.which("gocryptfs")
        self._build_interface()
        self.root.protocol("WM_DELETE_WINDOW", self.close_app)
        self._ensure_directories()
        self.refresh_status()

    def _build_interface(self):
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(1, weight=1)

        header = tk.Frame(self.root, bg=COLOR_BG)
        header.grid(row=0, column=0, sticky="ew", padx=24, pady=(20, 0))
        tk.Label(header, text="Quail Crypt", font=self.font_title,
                 fg=COLOR_TEXT, bg=COLOR_BG).pack(anchor="w")
        tk.Label(header, text="Manage your encrypted folder with gocryptfs",
                 font=self.font_label, fg=COLOR_TEXT_MUTED,
                 bg=COLOR_BG).pack(anchor="w", pady=(2, 8))
        tk.Frame(header, height=2, bg=COLOR_PRIMARY_LIGHT).pack(fill="x")

        content = tk.Frame(self.root, bg=COLOR_BG)
        content.grid(row=1, column=0, sticky="nsew", padx=24, pady=(14, 10))
        content.columnconfigure(0, weight=1)

        status_panel = tk.Frame(
            content, bg=COLOR_SURFACE_ALT, highlightbackground=COLOR_BORDER_GOLD,
            highlightthickness=1, padx=14, pady=12
        )
        status_panel.grid(row=0, column=0, sticky="ew", pady=(0, 12))
        status_panel.columnconfigure(1, weight=1)
        tk.Label(status_panel, text="Encryption Status", font=self.font_label,
                 fg=COLOR_TEXT_MUTED, bg=COLOR_SURFACE_ALT).grid(
                     row=0, column=0, sticky="w")
        self.status_var = tk.StringVar(value="Checking…")
        self.status_label = tk.Label(
            status_panel, textvariable=self.status_var, font=self.font_label,
            fg=COLOR_TEXT, bg=COLOR_SURFACE_ALT, anchor="e"
        )
        self.status_label.grid(row=0, column=1, sticky="e")
        self.detail_var = tk.StringVar(value="")
        tk.Label(status_panel, textvariable=self.detail_var, font=self.font_label,
                 fg=COLOR_TEXT_MUTED, bg=COLOR_SURFACE_ALT,
                 anchor="w", justify="left", wraplength=580).grid(
                     row=1, column=0, columnspan=2, sticky="ew", pady=(7, 0))

        paths = tk.Frame(content, bg=COLOR_SURFACE,
                         highlightbackground=COLOR_BORDER, highlightthickness=1,
                         padx=14, pady=12)
        paths.grid(row=1, column=0, sticky="ew", pady=(0, 12))
        paths.columnconfigure(1, weight=1)
        tk.Label(paths, text="ENCRYPTED DIRECTORY", font=self.font_label,
                 fg=COLOR_TEXT_MUTED, bg=COLOR_SURFACE).grid(
                     row=0, column=0, columnspan=2, sticky="w", pady=(0, 3))
        tk.Label(paths, text="🔒", font=(FONT_PRIMARY, 15), fg=COLOR_TEXT,
                 bg=COLOR_SURFACE).grid(row=1, column=0, sticky="w", padx=(0, 9))
        tk.Label(paths, text="~/encrypted", font=self.font_path, fg=COLOR_TEXT,
                 bg=COLOR_SURFACE, anchor="w").grid(row=1, column=1, sticky="ew")
        tk.Frame(paths, height=1, bg=COLOR_BORDER).grid(
            row=2, column=0, columnspan=2, sticky="ew", pady=10)
        tk.Label(paths, text="PRIVATE DIRECTORY", font=self.font_label,
                 fg=COLOR_TEXT_MUTED, bg=COLOR_SURFACE).grid(
                     row=3, column=0, columnspan=2, sticky="w", pady=(0, 3))
        tk.Label(paths, text="📁", font=(FONT_PRIMARY, 15), fg=COLOR_TEXT,
                 bg=COLOR_SURFACE).grid(row=4, column=0, sticky="w", padx=(0, 9))
        tk.Label(paths, text="~/private", font=self.font_path, fg=COLOR_TEXT,
                 bg=COLOR_SURFACE, anchor="w").grid(row=4, column=1, sticky="ew")

        actions = tk.Frame(content, bg=COLOR_BG)
        actions.grid(row=2, column=0, sticky="ew")
        actions.columnconfigure(0, weight=1)
        actions.columnconfigure(1, weight=1)
        self.primary_button = self._make_button(
            actions, "Unlock Encrypted Folder", lambda: self._run_action(self.unlock))
        self.primary_button.grid(row=0, column=0, sticky="ew", padx=(0, 5), pady=(0, 8))
        self.create_button = self._make_button(
            actions, "Create Encrypted Folder", lambda: self._run_action(self.create_encrypted_folder))
        self.create_button.grid(row=0, column=1, sticky="ew", padx=(5, 0), pady=(0, 8))
        self.open_button = self._make_button(
            actions, "Open Private Folder", lambda: self._run_action(self.open_private_folder))
        self.open_button.grid(row=1, column=0, sticky="ew", padx=(0, 5))
