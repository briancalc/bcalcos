# ============================================================
# CSS
# ============================================================

def install_css():
    provider = Gtk.CssProvider()

    try:
        provider.load_from_data(
            MAIN_CSS.encode("utf-8")
        )
    except Exception as exc:
        print(
            f"quail: unable to load CSS: {exc}",
            file=sys.stderr
        )
        return

    screen = Gdk.Screen.get_default()

    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )


# ============================================================
# DELAY PARSING
# ============================================================

def parse_delay(delay_str):
    """
    Accept:

        MM
        HH:MM

    Examples:

        5       -> 5 minutes
        15      -> 15 minutes
        45      -> 45 minutes
        1:30    -> 1 hour 30 minutes
        02:15   -> 2 hours 15 minutes
    """

    text = delay_str.strip()

    if not text:
        return None

    # Minutes only.
    if re.fullmatch(r"\d{1,4}", text):
        minutes = int(text)

        if minutes <= 0:
            return None

        return minutes * 60

    # HH:MM.
    match = re.fullmatch(
        r"(\d{1,3}):(\d{2})",
        text
    )

    if not match:
        return None

    hours = int(match.group(1))
    minutes = int(match.group(2))

    if minutes > 59:
        return None

    total_seconds = (
        hours * 3600 +
        minutes * 60
    )

    if total_seconds <= 0:
        return None

    return total_seconds


# ============================================================
# NOTIFICATION
# ============================================================

def show_notification(event_text):

    command = [
        "notify-send",
        "--app-name=Quail Reminder",
        "--urgency=normal",
        f"--expire-time={NOTIFICATION_TIMEOUT}",
        APP_NAME,
        event_text,
    ]

    try:
        subprocess.run(
            command,
            check=False,
            timeout=10,
        )

    except FileNotFoundError:
        print(
            "quail: notify-send is not installed",
            file=sys.stderr
        )

    except subprocess.TimeoutExpired:
        print(
            "quail: notify-send timed out",
            file=sys.stderr
        )

    except Exception as exc:
        print(
            f"quail: notification error: {exc}",
            file=sys.stderr
        )


# ============================================================
# SOUND
# ============================================================

def play_sound():

    if not os.path.isfile(SOUND_FILE):
        print(
            f"quail: sound file not found: {SOUND_FILE}",
            file=sys.stderr
        )
        return

    try:
        subprocess.run(
            ["paplay", SOUND_FILE],
            check=False,
            timeout=10,
        )

    except FileNotFoundError:
        print(
            "quail: paplay is not installed",
            file=sys.stderr
        )

    except subprocess.TimeoutExpired:
        print(
            "quail: paplay timed out",
            file=sys.stderr
        )

    except Exception as exc:
        print(
            f"quail: sound error: {exc}",
            file=sys.stderr
        )


# ============================================================
# REMINDER MODE
# ============================================================

def run_reminder(delay_seconds, event_text):

    try:
        time.sleep(delay_seconds)

        # Exactly one notification.
        show_notification(event_text)

        # Exactly one sound.
        play_sound()

    except KeyboardInterrupt:
        pass

    except Exception as exc:
        print(
            f"quail: reminder error: {exc}",
            file=sys.stderr
        )

    return 0


# ============================================================
# START REMINDER
# ============================================================

def start_reminder(delay_seconds, event_text):

    # sys.argv[0] is the path used to launch Quail.
    program = os.path.abspath(sys.argv[0])

    command = [
        sys.executable,
        program,
        "--reminder",
        str(delay_seconds),
        event_text,
    ]

    try:
        subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )

        return True

    except Exception as exc:
        print(
            f"quail: unable to start reminder: {exc}",
            file=sys.stderr
        )
        return False


# ============================================================
# MAIN WINDOW
# ============================================================

class ReminderWindow(Gtk.Window):

    def __init__(self):

        super().__init__(
            type=Gtk.WindowType.TOPLEVEL
        )

        self.pending_reminder = None

        # ----------------------------------------------------
        # Window
        # ----------------------------------------------------

        self.set_title("")

        self.set_default_size(
            WINDOW_WIDTH,
            WINDOW_HEIGHT
        )

        self.set_position(
            Gtk.WindowPosition.CENTER
        )

        self.set_decorated(True)

        # ----------------------------------------------------
        # Main container
        # ----------------------------------------------------

        main_vbox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=8
        )

        main_vbox.set_margin_start(14)
        main_vbox.set_margin_end(14)
        main_vbox.set_margin_top(12)
        main_vbox.set_margin_bottom(12)

        # ----------------------------------------------------
        # Event row
        # ----------------------------------------------------

        row_event = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8
        )

        label_event = Gtk.Label(
            label="Event:"
        )

        label_event.set_size_request(
            90,
            -1
        )

        label_event.set_halign(
            Gtk.Align.START
        )

        label_event.get_style_context().add_class(
            "reminder-label"
        )

        self.entry_event = Gtk.Entry()

        self.entry_event.set_placeholder_text(
            "What should I remind you about?"
        )

        self.entry_event.set_hexpand(True)

        self.entry_event.get_style_context().add_class(
            "reminder-entry"
        )

        row_event.pack_start(
            label_event,
            False,
            False,
            0
        )

        row_event.pack_start(
            self.entry_event,
            True,
            True,
            0
        )

        # ----------------------------------------------------
        # Delay row
        # ----------------------------------------------------

        row_delay = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8
        )

        label_delay = Gtk.Label(
            label="Delay:"
        )

        label_delay.set_size_request(
            90,
            -1
        )

        label_delay.set_halign(
            Gtk.Align.START
        )

        label_delay.get_style_context().add_class(
            "reminder-label"
        )

        self.entry_delay = Gtk.Entry()

        self.entry_delay.set_text(
            "00:15"
        )

        self.entry_delay.set_placeholder_text(
            "MM or HH:MM"
        )

        self.entry_delay.set_hexpand(True)

        self.entry_delay.get_style_context().add_class(
            "reminder-entry"
        )

        row_delay.pack_start(
            label_delay,
            False,
            False,
            0
        )

        row_delay.pack_start(
            self.entry_delay,
            True,
            True,
            0
        )

        # ----------------------------------------------------
        # Status
        # ----------------------------------------------------

        self.status_label = Gtk.Label()

        self.status_label.set_xalign(0.0)

        self.status_label.set_line_wrap(True)

        self.status_label.get_style_context().add_class(
            "reminder-status"
        )

        # ----------------------------------------------------
        # Bottom row
        # ----------------------------------------------------

        row_bottom = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8
        )

        label_title = Gtk.Label(
            label=APP_NAME
        )

        label_title.set_halign(
            Gtk.Align.START
        )

        label_title.get_style_context().add_class(
            "reminder-title"
        )

        self.button_set = Gtk.Button(
            label="Set"
        )

        self.button_set.set_size_request(
            75,
            -1
        )

        self.button_set.get_style_context().add_class(
            "reminder-button"
        )

        self.button_set.set_can_default(
            True
        )

        self.button_set.connect(
            "clicked",
            self.on_set_clicked
        )

        row_bottom.pack_start(
            label_title,
            True,
            True,
            0
        )

        row_bottom.pack_end(
            self.button_set,
            False,
            False,
            0
        )

        # ----------------------------------------------------
        # Pack
        # ----------------------------------------------------

        main_vbox.pack_start(
            row_event,
            False,
            False,
            0
        )

        main_vbox.pack_start(
            row_delay,
            False,
            False,
            0
        )

        main_vbox.pack_start(
            self.status_label,
            False,
            False,
            0
        )

        main_vbox.pack_start(
            row_bottom,
            False,
            False,
            0
        )

        self.add(main_vbox)

        # ----------------------------------------------------
        # Keyboard
        # ----------------------------------------------------

        self.entry_event.connect(
            "activate",
            self.on_entry_activate
        )

        self.entry_delay.connect(
            "activate",
            self.on_entry_activate
        )

        self.connect(
            "key-press-event",
            self.on_key_press
        )

        # ----------------------------------------------------
        # Window close
        # ----------------------------------------------------

        self.connect(
            "delete-event",
            self.on_delete_event
        )

        self.connect(
            "destroy",
            self.on_destroy
        )

        # ----------------------------------------------------
        # Display
        # ----------------------------------------------------

        self.show_all()

        self.entry_event.grab_focus()

    # ========================================================
    # ENTER
    # ========================================================

    def on_entry_activate(self, widget):
        """Enter activates Set."""

        self.on_set_clicked(
            self.button_set
        )

    # ========================================================
    # KEYBOARD
    # ========================================================

    def on_key_press(self, widget, event):

        key = Gdk.keyval_name(
            event.keyval
        )

        if key == "Escape":
            self.close()
            return True

        return False

    # ========================================================
    # SET
    # ========================================================

    def on_set_clicked(self, widget):

        event_text = (
            self.entry_event
            .get_text()
            .strip()
        )

        delay_text = (
            self.entry_delay
            .get_text()
            .strip()
        )

        # ----------------------------------------------------
        # Event validation
        # ----------------------------------------------------

        if not event_text:

            self.show_error(
                "Please enter an event description."
            )

            self.entry_event.grab_focus()

            return

        # ----------------------------------------------------
        # Delay validation
        # ----------------------------------------------------

        delay_seconds = parse_delay(
            delay_text
        )

        if delay_seconds is None:

            self.show_error(
                "Invalid delay.\n\n"
                "Use minutes, such as 15 or 45,\n"
                "or HH:MM, such as 01:30."
            )

            self.entry_delay.grab_focus()

            return

        # ----------------------------------------------------
        # Save reminder.
        # ----------------------------------------------------

        self.pending_reminder = (
            delay_seconds,
            event_text
        )

        # ----------------------------------------------------
        # Destroy GUI.
        # ----------------------------------------------------

        self.destroy()

    # ========================================================
    # ERROR
    # ========================================================

    def show_error(self, message):

        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text="quail reminder"
        )

        dialog.format_secondary_text(
            message
        )

        dialog.run()

        dialog.destroy()

    # ========================================================
    # CLOSE
    # ========================================================

    def on_delete_event(self, widget, event):
        return False

    def on_destroy(self, widget):
        Gtk.main_quit()


# ============================================================
# GUI MODE
# ============================================================

def run_gui():

    signal.signal(
        signal.SIGINT,
        signal.SIG_DFL
    )

    install_css()

    window = ReminderWindow()

    Gtk.main()

    # No reminder was set.
    if window.pending_reminder is None:
        return 0

    delay_seconds, event_text = (
        window.pending_reminder
    )

    if not start_reminder(
        delay_seconds,
        event_text
    ):
        return 1

    return 0


# ============================================================
# MAIN
# ============================================================

def main():

    # --------------------------------------------------------
    # Internal reminder mode.
    #
    # Example:
    #
    # quail-reminder --reminder 900 "Check oven"
    # --------------------------------------------------------

    if len(sys.argv) >= 4 and sys.argv[1] == "--reminder":

        try:
            delay_seconds = int(
                sys.argv[2]
            )
        except ValueError:
            print(
                "quail: invalid reminder delay",
                file=sys.stderr
            )
            return 1

        event_text = sys.argv[3]

        if delay_seconds <= 0:
            print(
                "quail: invalid reminder delay",
                file=sys.stderr
            )
            return 1

        return run_reminder(
            delay_seconds,
            event_text
        )

    # --------------------------------------------------------
    # Normal GUI mode.
    # --------------------------------------------------------

    return run_gui()


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    sys.exit(main())
