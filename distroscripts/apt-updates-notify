#!/bin/sh
#apt-updates-notify
#daily check for updates
#v1.4
#
PATH=/usr/sbin:/usr/bin:/sbin:/bin

notify_user() {
    u="$1"
    title="$2"
    body="$3"

    uid=$(id -u "$u" 2>/dev/null) || return
    runtime="/run/user/$uid"
    bus="$runtime/bus"

    [ -S "$bus" ] || return

    # Play the notification chime when available.
    if command -v paplay >/dev/null 2>&1 &&
       [ -r /usr/share/sounds/freedesktop/stereo/message.oga ]; then
        su - "$u" -c "env XDG_RUNTIME_DIR='$runtime' paplay /usr/share/sounds/freedesktop/stereo/message.oga" 2>/dev/null
    fi

    # Send the desktop notification.
    su - "$u" -c "env XDG_RUNTIME_DIR='$runtime' DBUS_SESSION_BUS_ADDRESS='unix:path=$bus' notify-send -u normal '$title' '$body'" 2>/dev/null
}

# Refresh package lists before checking for upgrades.
if ! apt-get update -qq >/dev/null 2>&1; then
    logger -t apt-updates-notify \
        "APT package-list refresh failed; skipping update notification."
    exit 1
fi

logged_in_users=$(who | awk '{print $1}' | sort -u)
[ -n "$logged_in_users" ] || exit 0

apt_count=$(apt list --upgradable 2>/dev/null | awk 'NR>1 && $1!="" {c++} END {print c+0}')

for u in $logged_in_users; do
    [ "$apt_count" -gt 0 ] && \
        notify_user "$u" "Apt updates available" "$apt_count package(s) can be upgraded"
done