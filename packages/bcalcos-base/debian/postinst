#!/bin/sh
set -e

# Restore BcalcOS identity after installation or upgrade.
# /usr/lib/os-release is owned by base-files; this copy intentionally
# reasserts the BcalcOS version after bcalcos-base is installed.

cp -f /usr/share/bcalcosbrand/os-release /usr/lib/os-release

# Regenerate GRUB configuration to apply BcalcOS GRUB settings,
# including suppression of memtest86+ menu entries.
if command -v update-grub >/dev/null 2>&1 &&
   [ -e /boot/grub/grub.cfg ]; then
    update-grub
fi

exit 0